{
  "name": "chat-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "lint": "biome check src",
    "lint:watch": "npx onchange \"src/**/*.ts\" -- biome check src",
    "lint:write": "npx @biomejs/biome check --write",
    "dev": "npm run --silent build && node dist/server.js",
    "dev:watch": "npx onchange -i -k \"**/*.ts\" -e \"dist/**\" -- npm run --silent dev",
    "dev:all": "npx concurrently     --names \"lint,server\"     --prefix-colors \"magenta,cyan\"     --prefix \"[{name}]\"     \"npm run --silent lint:watch\"     \"npm run --silent dev:watch\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/express": "5.0.6",
    "concurrently": "9.2.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "socket.io": "4.8.3",
    "uuid": "13.0.0",
    "zod": "4.3.5"
  }
}
