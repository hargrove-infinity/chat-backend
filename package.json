{
  "name": "chat-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "lint:watch": "npx onchange \"src/**/*.ts\" -- biome check src",
    "build:watch": "npx onchange -i -k \"**/*.ts\" -e \"dist/**\" -- npm run --silent build:run",
    "build:run": "npx tsc && node dist/server.js",
    "dev": "npx concurrently --names \"Lint,Server\"   --prefix \"[{time} {name}]\"   --timestamp-format \"yyyy-MM-dd HH:mm:ss.SSS\"   --prefix-colors \"magenta,cyan\"   \"npm run --silent lint:watch\"   \"npm run --silent build:watch\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/express": "5.0.6",
    "concurrently": "9.2.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "socket.io": "4.8.3",
    "uuid": "13.0.0",
    "zod": "4.3.5"
  }
}
